      "html": "\n<div class=\"telar-widget telar-widget-tabs\">\n  \n  <ul class=\"nav nav-tabs\" role=\"tablist\">\n    \n    <li class=\"nav-item\" role=\"presentation\">\n      <button class=\"nav-link active\"\n              id=\"tab-widget-2-1-tab\"\n              data-bs-toggle=\"tab\"\n              data-bs-target=\"#tab-widget-2-1\"\n              type=\"button\"\n              role=\"tab\"\n              aria-controls=\"tab-widget-2-1\"\n              aria-selected=\"true\">\n        First tab\n      </button>\n    </li>\n    \n    <li class=\"nav-item\" role=\"presentation\">\n      <button class=\"nav-link \"\n              id=\"tab-widget-2-2-tab\"\n              data-bs-toggle=\"tab\"\n              data-bs-target=\"#tab-widget-2-2\"\n              type=\"button\"\n              role=\"tab\"\n              aria-controls=\"tab-widget-2-2\"\n              aria-selected=\"false\">\n        Second tab\n      </button>\n    </li>\n    \n  </ul>\n\n  \n  <div class=\"tab-content\">\n    \n    <div class=\"tab-pane fade show active\"\n         id=\"tab-widget-2-1\"\n         role=\"tabpanel\"\n         aria-labelledby=\"tab-widget-2-1-tab\">\n      <div class=\"tab-pane-content\">\n        <p>First <strong>bold</strong> paragraph.<br />\nAnother line.</p>\n      </div>\n    </div>\n    \n    <div class=\"tab-pane fade \"\n         id=\"tab-widget-2-2\"\n         role=\"tabpanel\"\n         aria-labelledby=\"tab-widget-2-2-tab\">\n      <div class=\"tab-pane-content\">\n        <p>An <em>italic</em> paragraph.</p>\n      </div>\n    </div>\n    \n  </div>\n</div>",
