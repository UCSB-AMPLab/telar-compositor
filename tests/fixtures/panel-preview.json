    {
      "kind": "carousel",
      "source": ":::carousel\nimage: https://example.org/first.jpg\nalt: First image\ncaption: First **caption**\ncredit: Example credit\nwidth: 1000\nheight: 500\n---\nimage: https://example.org/second.jpg\nalt: Second image\ncaption: Second _caption_\ncredit: Second credit\nwidth: 1000\nheight: 500\n:::",
      "html": "\n<div class=\"telar-widget telar-widget-carousel\">\n  <div id=\"carousel-widget-4\" class=\"carousel slide carousel-size-compact\" data-bs-ride=\"false\">\n    \n    <div class=\"carousel-indicators\">\n      \n      <button type=\"button\" data-bs-target=\"#carousel-widget-4\"\n              data-bs-slide-to=\"0\"\n              class=\"active\" aria-current=\"true\"\n              aria-label=\"Slide 1\"></button>\n      \n      <button type=\"button\" data-bs-target=\"#carousel-widget-4\"\n              data-bs-slide-to=\"1\"\n              \n              aria-label=\"Slide 2\"></button>\n      \n    </div>\n\n    \n    <div class=\"carousel-inner\">\n      \n      <div class=\"carousel-item active\">\n        <div class=\"carousel-image-container\">\n          <img src=\"https://example.org/first.jpg\"\n               alt=\"First image\"\n               class=\"d-block carousel-image\">\n        </div>\n        \n        <div class=\"carousel-caption-below\">\n          \n          <p class=\"caption-text\">First <strong>caption</strong></p>\n          \n          \n          <p class=\"caption-credit\"><small>Example credit</small></p>\n          \n        </div>\n        \n      </div>\n      \n      <div class=\"carousel-item \">\n        <div class=\"carousel-image-container\">\n          <img src=\"https://example.org/second.jpg\"\n               alt=\"Second image\"\n               class=\"d-block carousel-image\">\n        </div>\n        \n        <div class=\"carousel-caption-below\">\n          \n          <p class=\"caption-text\">Second <em>caption</em></p>\n          \n          \n          <p class=\"caption-credit\"><small>Second credit</small></p>\n          \n        </div>\n        \n      </div>\n      \n    </div>\n\n    \n    <button class=\"carousel-control-prev\" type=\"button\"\n            data-bs-target=\"#carousel-widget-4\" data-bs-slide=\"prev\">\n      <span class=\"carousel-control-prev-icon\" aria-hidden=\"true\"></span>\n      <span class=\"visually-hidden\">Previous</span>\n    </button>\n    <button class=\"carousel-control-next\" type=\"button\"\n            data-bs-target=\"#carousel-widget-4\" data-bs-slide=\"next\">\n      <span class=\"carousel-control-next-icon\" aria-hidden=\"true\"></span>\n      <span class=\"visually-hidden\">Next</span>\n    </button>\n  </div>\n</div>",
